PORT=4040

# PostgreSQL connection (the same values you use in DBeaver)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=foodies

# secret used to sign the login tokens (JWT). any long random text
JWT_SECRET=change_me_to_a_long_random_string

# Google sign-in (optional): create an OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4040/api/auth/google/callback
