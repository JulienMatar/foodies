PORT=4040

# development on our computers, production once online (turns on https-only cookies and HSTS)
NODE_ENV=development

# PostgreSQL connection (the same values you use in DBeaver)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=foodies

# online: the host gives one URL instead of the 5 values above (it wins when it is set)
# DATABASE_URL=postgres://user:password@host:5432/foodies

# secret used to sign the login tokens (JWT): 32 characters minimum.
# make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_of_32_chars_or_more

# Google sign-in (optional): create an OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4040/api/auth/google/callback

# Ask Teta with AI (optional): a key from https://platform.openai.com/api-keys
# empty = Teta answers with her built-in rules
OPENAI_API_KEY=
# the model to use (empty = the default in utils/helper4.js)
OPENAI_MODEL=
# at most this many AI answers per day for the whole site, to protect the bill
CHAT_DAILY_LIMIT=300
